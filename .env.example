# Required in production: the passcode for signing in.
APP_PASSCODE=

# Optional: signs session cookies. Set any long random string; if empty, it's derived from APP_PASSCODE.
SESSION_SECRET=

# Postgres (Neon). Set automatically when you connect a Neon database in Vercel → Storage.
DATABASE_URL=

# Optional: higher rate limits for the Pokémon TCG pricing API (https://dev.pokemontcg.io).
POKEMONTCG_API_KEY=
